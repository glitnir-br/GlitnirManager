{
  "name": "Banido",
  "type": "object",
  "properties": {
    "nick": {
      "type": "string",
      "description": "Nickname do jogador"
    },
    "steamid": {
      "type": "string",
      "description": "Steam ID do jogador"
    },
    "motivo": {
      "type": "string",
      "enum": [
        "CHEAT",
        "GROSSEIRO",
        "ASSEDIO",
        "TOXICO",
        "GOLPE",
        "OUTRO"
      ],
      "description": "Motivo do banimento"
    },
    "observacao": {
      "type": "string",
      "description": "Detalhes adicionais"
    }
  },
  "required": [
    "steamid"
  ]
}