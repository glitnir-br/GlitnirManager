{
  "name": "AdminSettings",
  "type": "object",
  "properties": {
    "setting_key": {
      "type": "string",
      "description": "Chave da configura\u00e7\u00e3o"
    },
    "admin_password": {
      "type": "string",
      "description": "Senha administrativo criptografada"
    },
    "updated_by": {
      "type": "string",
      "description": "Email do ADM que atualizou"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima atualiza\u00e7\u00e3o"
    }
  },
  "required": [
    "setting_key"
  ]
}