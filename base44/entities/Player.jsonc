{
  "name": "Player",
  "type": "object",
  "properties": {
    "nick": {
      "type": "string",
      "description": "Nickname do jogador"
    },
    "steamid": {
      "type": "string",
      "description": "Steam ID do jogador"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo",
        "banido",
        "suspenso"
      ],
      "default": "ativo",
      "description": "Status do jogador"
    },
    "guilda": {
      "type": "string",
      "description": "Guilda do jogador"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre o jogador"
    },
    "cor": {
      "type": "string",
      "description": "Cor personalizada para destacar o jogador"
    },
    "duplicado": {
      "type": "boolean",
      "default": false,
      "description": "Se o jogador tem nick ou steamid duplicado"
    },
    "ordem": {
      "type": "number",
      "description": "Posi\u00e7\u00e3o de exibi\u00e7\u00e3o do jogador na lista"
    }
  },
  "required": [
    "nick",
    "steamid"
  ]
}