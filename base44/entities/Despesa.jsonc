{
  "name": "Despesa",
  "type": "object",
  "properties": {
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data da despesa"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da despesa"
    },
    "valor": {
      "type": "number",
      "description": "Valor da despesa"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria da despesa"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    },
    "status_pagamento": {
      "type": "string",
      "enum": [
        "pago",
        "nao_pago"
      ],
      "default": "nao_pago",
      "description": "Status de pagamento da despesa"
    }
  },
  "required": [
    "descricao",
    "valor"
  ]
}