{
  "name": "AccessRequest",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email do usu\u00e1rio solicitando acesso"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "bloqueado"
      ],
      "default": "pendente",
      "description": "Status da solicita\u00e7\u00e3o"
    },
    "role": {
      "type": "string",
      "enum": [
        "nenhum",
        "administrador",
        "financeiro",
        "moderador",
        "suporte",
        "visitante"
      ],
      "default": "nenhum",
      "description": "Cargo atribu\u00eddo ao usu\u00e1rio"
    }
  },
  "required": [
    "email"
  ]
}