{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "photo_url": {
      "type": "string",
      "description": "URL da foto do Google"
    },
    "role": {
      "type": "string",
      "enum": [
        "adm_principal",
        "administrador",
        "financeiro",
        "moderador",
        "suporte",
        "visitante",
        "pendente",
        "bloqueado"
      ],
      "default": "pendente",
      "description": "Cargo do usu\u00e1rio"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo",
        "bloqueado",
        "pendente"
      ],
      "default": "pendente",
      "description": "Status de acesso do usu\u00e1rio"
    },
    "approved_by": {
      "type": "string",
      "description": "Email do usu\u00e1rio que aprovou"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data de aprova\u00e7\u00e3o"
    },
    "observations": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre o usu\u00e1rio"
    },
    "last_login": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltimo acesso"
    },
    "two_fa_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Se autentica\u00e7\u00e3o de dois fatores est\u00e1 habilitada"
    },
    "backup_codes": {
      "type": "string",
      "description": "C\u00f3digos de backup para 2FA (criptografados)"
    }
  },
  "required": [
    "email"
  ]
}